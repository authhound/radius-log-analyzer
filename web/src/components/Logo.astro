---
// AuthHound mark: front-facing bloodhound. Silhouette uses the amber brand
// color; detail cutouts use the page background variable so the mark works
// in header, footer, and both themes.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  aria-hidden="true"
  class="logo-mark"
>
  <g transform="translate(0,2)">
    <g fill="var(--accent-mark)">
      <ellipse cx="19" cy="52" rx="9" ry="26" transform="rotate(7 19 52)"></ellipse>
      <ellipse cx="77" cy="52" rx="9" ry="26" transform="rotate(-7 77 52)"></ellipse>
      <circle cx="48" cy="38" r="22"></circle>
      <ellipse cx="37" cy="59" rx="8.5" ry="11"></ellipse>
      <ellipse cx="59" cy="59" rx="8.5" ry="11"></ellipse>
      <ellipse cx="48" cy="56" rx="13" ry="13"></ellipse>
    </g>
    <g fill="var(--bg)">
      <ellipse cx="39.5" cy="36.5" rx="3.1" ry="2.5"></ellipse>
      <ellipse cx="56.5" cy="36.5" rx="3.1" ry="2.5"></ellipse>
      <path
        d="M44 50 h8 a1.8 1.8 0 0 1 1.45 2.9 l-4 5.2 a1.8 1.8 0 0 1 -2.9 0 l-4 -5.2 a1.8 1.8 0 0 1 1.45 -2.9 z"
      ></path>
    </g>
  </g>
</svg>
