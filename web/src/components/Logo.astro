---
// AuthHound mark: front-facing hound glyph. Fills follow currentColor for the
// silhouette; detail cutouts use the page background variable so the mark
// works in header, footer, and both themes.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  aria-hidden="true"
  class="logo-mark"
>
  <g transform="translate(0,4)">
    <g fill="var(--accent-mark)">
      <ellipse cx="21" cy="49" rx="9.5" ry="23" transform="rotate(9 21 49)"></ellipse>
      <ellipse cx="75" cy="49" rx="9.5" ry="23" transform="rotate(-9 75 49)"></ellipse>
      <circle cx="48" cy="40" r="23"></circle>
      <ellipse cx="48" cy="57" rx="14" ry="14"></ellipse>
    </g>
    <g fill="var(--bg)">
      <circle cx="39.5" cy="36" r="3"></circle>
      <circle cx="56.5" cy="36" r="3"></circle>
      <path
        d="M44.5 51.5 h7 a1.6 1.6 0 0 1 1.3 2.6 l-3.5 4.6 a1.6 1.6 0 0 1 -2.6 0 l-3.5 -4.6 a1.6 1.6 0 0 1 1.3 -2.6 z"
      ></path>
    </g>
  </g>
</svg>
