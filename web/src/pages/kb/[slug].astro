---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const kbPages = await getCollection('kb');
  return kbPages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.description}>
  <article>
    <p class="also">
      <code>{page.data.signature}</code>
    </p>
    <h1>{page.data.title}</h1>
    <Content />
  </article>
  <div class="cta-box">
    <h2>Diagnose your actual log</h2>
    <p>
      Generic explanations only go so far.
      <a href="/analyzer">Paste your full log into the analyzer</a> — it
      detects this failure and 18 others, ranks the likely causes for your
      specific output, and runs entirely in your browser. Nothing is uploaded.
    </p>
  </div>
</Base>
